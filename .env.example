# Bashiqa School Manager — copy to ".env" and fill in (never commit .env)

# MySQL
DB_HOST=localhost
DB_NAME=school_db
DB_USER=root
DB_PASS=

# Optional: charset
DB_CHARSET=utf8mb4

# Optional: Windows Task Scheduler / cron wrapper — full path to php.exe if not in PATH
# PHP_CLI=C:\xampp\php\php.exe
